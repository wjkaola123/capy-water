{
  "expo": {
    "name": "卡皮补水站",
    "slug": "capy-water",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "backgroundColor": "#e8eeda",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capywater.app"
    },
    "android": {
      "package": "com.capywater.app"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "name": "卡皮补水站",
      "output": "single"
    },
    "plugins": ["expo-font", "expo-status-bar", "expo-notifications"]
  }
}
